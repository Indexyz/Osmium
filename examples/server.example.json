{
  "server_id": "osmium-1",
  "listen": "127.0.0.1:8080",
  "public_url": "https://ssh.example.com",
  "policy_file": "/etc/osmium/policy.json",
  "state_db": "/var/lib/osmium/osmium.db",

  "agent_listen": ":8443",
  "agent_tls_cert": "/etc/osmium/pki/server.crt",
  "agent_tls_key": "/etc/osmium/pki/server.key",
  "agent_client_ca": "/etc/osmium/pki/agent-ca.crt",

  "oidc": {
    "issuer": "https://idp.example.com",
    "client_id": "osmium",
    "client_secret_file": "/etc/osmium/oidc-client-secret",
    "redirect_url": "https://ssh.example.com/auth/callback",
    "scopes": ["openid", "profile", "email", "groups"],
    "groups_claim": "groups"
  },
  "web_session_ttl": "8h",

  "audit": {
    "dir": "/var/lib/osmium/audit",
    "retention": "2160h",
    "stdout": false
  },

  "ca": {
    "url": "https://ca.example.com",
    "root_ca_file": "/etc/osmium/step-root.pem",
    "provisioner_name": "web-ssh",
    "jwk_file": "/etc/osmium/provisioner.jwk",
    "jwk_password_file": "/etc/osmium/provisioner.password",
    "timeout": "5s",
    "user_ca_public_key_file": "/etc/osmium/user_ca.pub",
    "max_cert_lifetime": "5m",
    "allowed_extensions": ["permit-pty"],
    "required_source_address": ""
  },

  "direct_ca": {
    "provisioner_name": "direct-ssh",
    "jwk_file": "/etc/osmium/direct-provisioner.jwk",
    "jwk_password_file": "/etc/osmium/direct-provisioner.password",
    "default_host_ttl": "60s",
    "default_role_ttl": "4h",
    "max_role_ttl": "8h",
    "allowed_extensions": ["permit-pty", "permit-user-rc", "permit-port-forwarding"],
    "source_address_mode": "none",
    "source_address_cidrs": "",
    "trusted_proxies": []
  },

  "sessions": {
    "attach_timeout": "60s",
    "ssh_handshake": "15s",
    "max_session_duration": "8h",
    "idle_timeout": "30m",
    "max_per_user": 10,
    "max_total": 1000,
    "max_concurrent_signs": 16,
    "revoke_active": true
  },

  "ping_interval": "45s",
  "heartbeat_timeout": "135s",
  "mux_idle_ttl": "60s",
  "stream_open_timeout": "10s",
  "max_streams_per_agent": 32,
  "max_pending_streams_per_agent": 8,
  "agent_accept_rate": 4000,
  "agent_accept_burst": 8000
}
