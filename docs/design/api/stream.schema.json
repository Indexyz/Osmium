{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "smux stream prelude v1; uint32 BE length prefix is external",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "ssh.open"
        },
        "host_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "connection_epoch": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "version",
        "type",
        "host_id",
        "session_id",
        "attempt_id",
        "connection_epoch"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "ssh.open_result"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "ok": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z_]+$",
          "maxLength": 64
        }
      },
      "required": [
        "version",
        "type",
        "session_id",
        "attempt_id",
        "ok"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "code"
              ]
            }
          }
        }
      ]
    }
  ]
}
