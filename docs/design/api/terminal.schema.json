{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terminal text messages v1; binary data is not JSON",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "terminal.resize"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "cols": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "rows",
            "cols"
          ]
        }
      },
      "required": [
        "version",
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "terminal.close"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      },
      "required": [
        "version",
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "terminal.state"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "created",
                "waiting_agent",
                "signing",
                "ssh_authenticating",
                "active",
                "closing",
                "closed",
                "failed"
              ]
            }
          },
          "required": [
            "state"
          ]
        }
      },
      "required": [
        "version",
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "terminal.exit"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "maxLength": 256
            },
            "exit_status": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "reason"
          ]
        }
      },
      "required": [
        "version",
        "type",
        "payload"
      ]
    }
  ]
}
